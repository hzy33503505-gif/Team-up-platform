.home-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  padding: 24rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top-band {
  position: relative;
  overflow: hidden;
  background: var(--color-surface);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  border-radius: 34rpx;
  padding: 34rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin: 8rpx 0 30rpx;
  box-shadow: 0 28rpx 70rpx var(--color-shadow);
}

.top-band::before {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: var(--color-primary-soft-muted);
}

.top-band::after {
  content: "";
  position: absolute;
  left: 28rpx;
  bottom: 0;
  width: 240rpx;
  height: 2rpx;
  background: linear-gradient(90deg, var(--color-text), transparent);
}

.top-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.page-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
  color: var(--color-text);
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

.hero-action {
  width: 330rpx;
  min-height: 88rpx;
  line-height: 1.25;
  margin: 30rpx 0 0;
  font-size: 25rpx;
  box-shadow: 0 14rpx 32rpx var(--color-shadow);
}

.refresh-btn {
  flex: 0 0 auto;
  margin: 0 0 0 auto;
  align-self: flex-start;
  position: relative;
  z-index: 2;
  background: var(--color-secondary);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: 23rpx;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 4rpx 16rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 800;
  color: var(--color-text);
}

.section-link {
  color: var(--color-text);
  font-size: 24rpx;
}

.stat-card,
.tip-card,
.timeline-card,
.recommend-card,
.empty-card {
  background: var(--color-accent-warm);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 44rpx var(--color-shadow);
  animation: float-in 420ms ease both;
}

.empty-card {
  padding: 36rpx 26rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 25rpx;
  line-height: 1.6;
  background: var(--color-surface-soft);
}

.empty-card .ui-empty-action {
  margin-left: auto;
  margin-right: auto;
}

.recommend-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.recommend-card {
  padding: 24rpx;
  border-left: 6rpx solid var(--color-primary-soft);
}

.recommend-type {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-text);
  font-size: 21rpx;
  font-weight: 700;
}

.recommend-title {
  margin-top: 14rpx;
  font-size: 29rpx;
  color: var(--color-text);
  font-weight: 800;
  line-height: 1.42;
}

.recommend-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.62;
}

.recommend-btn {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 800;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-card {
  padding: 24rpx 10rpx;
  text-align: center;
  background: var(--color-surface-soft);
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-text);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.tip-card {
  padding: 26rpx;
  font-size: 25rpx;
  color: var(--color-text);
  line-height: 1.7;
  border-left: 6rpx solid var(--color-primary-soft);
}

.timeline-card {
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  margin-top: 13rpx;
  flex: 0 0 auto;
  box-shadow: 0 0 0 8rpx var(--color-shadow);
}

.timeline-body {
  flex: 1;
  min-width: 0;
}

.timeline-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.timeline-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.42;
}

.timeline-time {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: var(--color-text);
}

.timeline-desc {
  margin-top: 9rpx;
  font-size: 23rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}


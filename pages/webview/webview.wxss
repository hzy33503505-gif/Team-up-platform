.webview-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
}

.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.copy-btn {
  margin-top: 24rpx;
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 10rpx;
}


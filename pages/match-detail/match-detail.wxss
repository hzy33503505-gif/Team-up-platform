.detail-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(135deg, var(--color-primary-soft), var(--color-primary));
  border-radius: 28rpx;
  padding: 34rpx 28rpx;
  color: var(--color-text-body);
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 25rpx;
  line-height: 1.6;
  opacity: 0.95;
  padding-right: 140rpx;
}

.big-score {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  background: var(--color-surface-soft);
}

.score-box {
  width: 120rpx;
  min-width: 120rpx;
  text-align: center;
  border-radius: 18rpx;
  padding: 12rpx 0;
}

.score-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-body);
  line-height: 1.2;
}

.score-label {
  font-size: 20rpx;
  color: var(--color-text-mid);
  margin-top: 4rpx;
}

.content-card {
  background: var(--color-surface);
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx var(--color-shadow);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 14rpx;
}

.info-row {
  margin-bottom: 12rpx;
  line-height: 1.7;
}

.info-label {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--color-text);
}

.info-text {
  font-size: 25rpx;
  color: var(--color-text-muted);
  line-height: 1.7;
}

.tag-wrap {
  margin-bottom: 4rpx;
}

.reason-tags {
  margin-top: 14rpx;
}

.reason-tag {
  display: inline-block;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-primary-text);
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.factor-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.factor-item {
  background: var(--color-surface-soft);
  border-radius: 12rpx;
  text-align: center;
  padding: 14rpx 4rpx;
}

.factor-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.factor-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-primary-text);
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.primary-btn {
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 12rpx;
}

.action-btn {
  margin-top: 8rpx;
}

/* sticky-rice ice-cream premium UI */
.detail-page {
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  color: var(--color-text);
}

.hero-card,
.content-card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 44rpx var(--color-shadow);
}

.hero-card {
  animation: float-card 4.8s ease-in-out infinite;
}

.section-title,
.info-label,
.factor-value,
.hero-title {
  color: var(--color-text);
}

.hero-subtitle,
.info-text,
.factor-label {
  color: var(--color-text-muted);
}

.big-score,
.factor-item,
.reason-tag,
.tag {
  background: var(--color-surface-soft);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
}

.reason-tag,
.tag {
  color: var(--color-text);
}

.primary-btn {
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 999rpx;
  font-weight: 800;
}


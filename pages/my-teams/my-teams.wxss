.teams-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  padding: 24rpx;
  box-sizing: border-box;
}

.team-card,
.empty-card {
  background: var(--color-accent-warm);
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx var(--color-shadow);
}

.team-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.team-subtitle {
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.team-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.7;
}

.team-arrow {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 700;
}

.empty-card {
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-align: center;
}

.primary-btn {
  margin-top: 18rpx;
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 12rpx;
}

/* sticky-rice ice-cream premium UI */
.teams-page {
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  color: var(--color-text);
}

.team-card,
.empty-card {
  background: var(--color-accent-warm);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 44rpx var(--color-shadow);
  animation: float-in 360ms ease both;
}

.team-title {
  color: var(--color-text);
}

.team-subtitle,
.team-arrow {
  color: var(--color-text);
}

.team-desc,
.empty-card {
  color: var(--color-text-muted);
}

.primary-btn {
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 999rpx;
  font-weight: 800;
}


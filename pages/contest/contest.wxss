.contest-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(135deg, var(--color-primary-soft), var(--color-primary));
  border-radius: 20rpx;
  padding: 34rpx 28rpx;
  color: var(--color-text-body);
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  margin-bottom: 12rpx;
  opacity: 0.96;
}

.hero-desc {
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.search-panel {
  background: var(--color-surface);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx var(--color-shadow);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  background: var(--color-surface-soft);
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
  box-sizing: border-box;
}

.search-btn,
.refresh-btn {
  background: var(--color-secondary);
  color: var(--color-text);
  border-radius: 10rpx;
  font-size: 24rpx;
  border: 1rpx solid var(--color-border);}

.tool-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.update-text,
.update-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.update-time {
  margin-top: 8rpx;
}

.filter-bar {
  display: flex;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.insight-board {
  margin-bottom: 20rpx;
}

.insight-section {
  margin-bottom: 18rpx;
}

.insight-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.insight-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.insight-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.mini-scroll {
  width: 100%;
  white-space: nowrap;
}

.mini-list {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 2rpx;
}

.mini-card {
  flex: 0 0 auto;
  width: 520rpx;
  min-height: 184rpx;
  background: var(--color-surface);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 18rpx var(--color-shadow);
  border-left: 6rpx solid var(--color-primary-soft);
  white-space: normal;
}

.mini-card.hot {
  border-left-color: var(--color-primary);
}

.mini-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.35;
  min-height: 70rpx;
}

.mini-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 10rpx 0;
}

.mini-tag {
  flex: 0 0 auto;
  background: var(--color-primary-soft);
  color: var(--color-text);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-size: 21rpx;
}

.mini-date {
  color: var(--color-text);
  font-size: 22rpx;
}

.mini-date.muted {
  color: var(--color-text-muted);
}

.mini-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.filter-item {
  flex: 0 0 auto;
  padding: 10rpx 20rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.filter-item.active {
  background: var(--color-primary-soft);
  color: var(--color-text);
}

.content-card {
  background: var(--color-surface);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx var(--color-shadow);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.card-title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text);
}

.source-line {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.status-tag {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.status-tag.open {
  background: var(--color-primary-soft);
  color: var(--color-text);
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx 12rpx;
}

.meta-item {
  width: 50%;
  padding: 6rpx;
  box-sizing: border-box;
}

.meta-item.wide {
  width: 100%;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 4rpx;
}

.meta-value {
  display: block;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.meta-value.strong {
  color: var(--color-text);
}

.desc,
.info-text {
  font-size: 25rpx;
  color: var(--color-text-muted);
  line-height: 1.7;
}

.desc {
  margin-bottom: 14rpx;
}

.bonus-strip {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
}

.bonus-pill {
  display: inline-block;
  background: var(--color-surface-soft);
  color: var(--color-text-body);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
  font-size: 21rpx;
  line-height: 1.4;
}

.bonus-text {
  font-size: 23rpx;
  color: var(--color-text);
  line-height: 1.65;
}

.section-sub {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  margin: 12rpx 0 8rpx;
}

.tag-wrap {
  margin-bottom: 8rpx;
}

.tag {
  display: inline-block;
  background: var(--color-primary);
  color: var(--color-primary-text);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  font-size: 22rpx;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  border-radius: 10rpx;
  font-size: 25rpx;
  background: var(--color-primary);
  color: var(--color-primary-text);
  border: 1rpx solid var(--color-border);}

.primary-btn {
  background: var(--color-primary);
  color: var(--color-primary-text);
}

.secondary-btn {
  background: var(--color-secondary);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);}

.empty-state {
  background: var(--color-surface);
  border-radius: 16rpx;
  padding: 42rpx 24rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 25rpx;
}

.loading-state {
  text-align: left;
}

.state-title {
  margin-top: 22rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
}

.state-desc {
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.list-summary {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  background: var(--color-surface);
  border-radius: 14rpx;
  box-shadow: 0 6rpx 18rpx var(--color-shadow);
  font-size: 23rpx;
  color: var(--color-text-muted);
}

.contest-page-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 8rpx 0 26rpx;
}

.pager-btn {
  min-width: 150rpx;
  background: var(--color-surface);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
  font-size: 23rpx;
}

.pager-text {
  font-size: 23rpx;
  color: var(--color-text-muted);
}

/* sticky-rice ice-cream premium UI */
.contest-page {
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  padding: 24rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  color: var(--color-text);
}

.hero-card {
  position: relative;
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 34rpx;
  box-shadow: 0 28rpx 70rpx var(--color-shadow);
  animation: float-card 4.8s ease-in-out infinite;
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -90rpx;
  top: -110rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: var(--color-primary-soft-muted);
}

.hero-title,
.insight-title,
.card-title,
.section-sub {
  color: var(--color-text);
}

.hero-subtitle,
.hero-desc,
.insight-subtitle,
.source-line,
.desc,
.info-text,
.list-summary,
.pager-text,
.update-text,
.update-time,
.mini-desc,
.meta-label {
  color: var(--color-text-muted);
}

.search-panel,
.mini-card,
.filter-item,
.content-card,
.empty-state,
.list-summary {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 44rpx var(--color-shadow);
  animation: float-in 360ms ease both;
}

.search-input,
.filter-item,
.meta-item,
.bonus-strip {
  background: var(--color-surface-soft);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.search-input {
  border-radius: 999rpx;
  min-height: 80rpx;
}

.search-btn,
.refresh-btn,
.primary-btn {
  background: var(--color-secondary);
  color: var(--color-text);
  border-radius: 999rpx;
  font-weight: 800;
  min-height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid var(--color-border);}

.secondary-btn,
.pager-btn {
  background: var(--color-secondary);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}

.filter-item {
  color: var(--color-text);
}

.filter-item.active,
.mini-tag,
.status-tag.open,
.tag {
  background: var(--color-primary-soft);
  color: var(--color-text);
  border: 1rpx solid var(--color-primary-soft-muted);
}

.content-card:active,
.mini-card:active,
.filter-item:active {
  transform: translateY(6rpx) scale(0.99);
}

.mini-title,
.meta-value {
  color: var(--color-text);
}

.mini-date,
.meta-value.strong {
  color: var(--color-text);
}

.status-tag {
  background: var(--color-surface-soft);
  color: var(--color-text-muted);
}

.bonus-pill {
  background: var(--color-primary);
  color: var(--color-primary-text);
}

.bonus-text {
  color: var(--color-text);
}

.pager-btn[disabled] {
  background: var(--color-border-subtle);
  color: var(--color-text);
}

.content-card,
.mini-card {
  animation: none;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms cubic-bezier(0.16, 1, 0.3, 1);
}


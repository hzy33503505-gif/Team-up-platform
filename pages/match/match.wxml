<view class="match-page {{themeClass}}">
  <view class="top-panel">
    <view>
      <view class="page-title">队友匹配</view>
      <view class="page-subtitle">发布招募、发送申请、同意后组队成功</view>
    </view>
    <button class="profile-btn" size="mini" bindtap="goProfile">{{profileReady ? '资料已完善' : '完善资料'}}</button>
  </view>

  <view wx:if="{{!profileReady}}" class="notice-card">
    <view class="notice-title">匹配前需要补全个人信息</view>
    <view class="notice-text">缺少：{{profileMissingText}}。申请门槛、发布者联系人和适配度解释都依赖这些信息。</view>
  </view>

  <view wx:if="{{profileReady}}" class="profile-strip">
    <view class="profile-name">{{profile.name}} · {{profile.grade}}</view>
    <view class="profile-line">{{profile.campus}} / {{profile.college}} / {{profile.major}}</view>
    <view class="profile-line">{{profileContactText}}</view>
  </view>

  <view class="tab-row">
    <block wx:for="{{tabs}}" wx:key="value">
      <view class="tab-item {{activeTab == item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="changeTab">
        {{item.label}}
      </view>
    </block>
  </view>

  <block wx:if="{{activeTab == 'recruit'}}">
    <view class="section-head">
      <view>
        <view class="section-title">招募大厅</view>
        <view class="section-desc">适配度来自个人资料、岗位关键词、发布者门槛和申请说明。</view>
      </view>
      <button class="mini-btn" size="mini" bindtap="fetchPosts">刷新</button>
    </view>

    <view class="recruit-filter">
      <view class="search-line">
        <input
          class="recruit-search"
          placeholder="搜索竞赛、岗位、技能、学院或发布者"
          value="{{recruitKeyword}}"
          confirm-type="search"
          bindinput="onRecruitKeywordInput"
        />
        <button wx:if="{{recruitKeyword}}" class="clear-keyword" size="mini" bindtap="clearRecruitKeyword">清除</button>
      </view>
      <view class="filter-grid">
        <picker mode="selector" range="{{recruitStatusOptions}}" value="{{recruitStatusIndex}}" bindchange="onRecruitStatusChange">
          <view class="filter-picker">{{recruitStatusOptions[recruitStatusIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{recruitScopeOptions}}" value="{{recruitScopeIndex}}" bindchange="onRecruitScopeChange">
          <view class="filter-picker">{{recruitScopeOptions[recruitScopeIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{recruitSortOptions}}" value="{{recruitSortIndex}}" bindchange="onRecruitSortChange">
          <view class="filter-picker">{{recruitSortOptions[recruitSortIndex]}}</view>
        </picker>
      </view>
      <view class="filter-count">共 {{posts.length}} 条匹配结果</view>
    </view>

    <view wx:if="{{loadingPosts}}" class="empty-card">正在加载招募信息...</view>
    <view wx:if="{{!loadingPosts && posts.length == 0}}" class="empty-card">{{allPosts.length > 0 ? '没有符合筛选条件的招募' : '暂无真实招募。可以先到“发布招募”创建一条。'}}</view>

    <block wx:for="{{posts}}" wx:key="id" wx:for-item="post">
      <view class="post-card">
        <view class="card-top">
          <view class="card-main">
            <view class="card-title">{{post.title}}</view>
            <view class="card-subtitle">{{post.contest_name || '未填写目标竞赛'}}</view>
          </view>
          <view class="status-pill {{post.remaining == 0 ? 'full' : ''}}">{{post.status}}</view>
        </view>

        <view class="publisher-box">
          <view class="publisher-name">{{post.publisher_profile.name}} · {{post.publisher_profile.grade}}</view>
          <view class="publisher-line">{{post.publisher_profile.campus}} / {{post.publisher_profile.college}} / {{post.publisher_profile.major}}</view>
          <view class="publisher-line">{{post.publisherContactText}}</view>
        </view>

        <view class="post-desc">{{post.description}}</view>

        <view class="info-grid">
          <view class="info-box">
            <view class="info-label">招募进度</view>
            <view class="info-value">{{post.total_filled}} / {{post.total_needed}}</view>
          </view>
          <view class="info-box">
            <view class="info-label">申请门槛</view>
            <view class="info-value">{{post.gatesText}}</view>
          </view>
          <view class="info-box">
            <view class="info-label">申请说明</view>
            <view class="info-value">{{post.needStatementText}}</view>
          </view>
        </view>

        <view wx:if="{{profileReady && !post.is_publisher}}" class="score-panel">
          <view class="score-number">{{post.match_score}}</view>
          <view class="score-main">
            <view class="score-title">当前资料适配度</view>
            <view class="score-text">{{post.matchDetailText}}</view>
            <view class="score-text muted">{{post.matchReasonText}}</view>
          </view>
        </view>

        <view class="role-list">
          <block wx:for="{{post.roles}}" wx:key="id" wx:for-item="role">
            <view class="role-card">
              <view class="role-head">
                <view>
                  <view class="role-title">{{role.name}}</view>
                  <view class="role-subtitle">{{role.direction}} · {{role.skillsText}}</view>
                </view>
                <view class="role-status {{role.remaining == 0 ? 'done' : ''}}">{{role.statusText}}</view>
              </view>

              <view wx:if="{{role.confirmed_members.length > 0}}" class="member-list">
                <block wx:for="{{role.confirmed_members}}" wx:key="user_id" wx:for-item="member">
                  <view class="member-chip">已确定：{{member.profile.name}} / {{member.contactText}}</view>
                </block>
              </view>

              <view wx:if="{{role.remaining > 0 && !post.is_publisher}}" class="apply-box">
                <input
                  class="apply-input"
                  placeholder="{{post.gates.require_statement ? '发布者要求填写申请说明：请说明优势和可投入时间' : '可选：说明你的优势和可投入时间'}}"
                  maxlength="220"
                  data-key="{{role.applyKey}}"
                  bindinput="onApplicationInput"
                />
                <button class="primary-btn" size="mini" data-postid="{{post.id}}" data-roleid="{{role.id}}" data-key="{{role.applyKey}}" bindtap="sendApplication">发送申请</button>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>
  </block>

  <block wx:if="{{activeTab == 'publish'}}">
    <view class="section-title">发布招募</view>
    <view class="section-desc">AI辅助整理是可选项；用户仍可以直接手动发布。</view>

    <view class="form-card">
      <view class="form-item">
        <view class="form-label">招募标题</view>
        <input class="form-input" data-field="title" value="{{form.title}}" placeholder="例如：数模国赛论文队友招募" bindinput="onFormInput" />
      </view>
      <view class="form-item">
        <view class="form-label">目标竞赛</view>
        <view class="picker-box required-picker contest-select-trigger" bindtap="openContestSelector">
          <text class="contest-select-name">{{contestOptions[contestIndex]}}</text>
          <text class="contest-select-hint">搜索选择</text>
        </view>
        <input
          wx:if="{{contestOptions[contestIndex] == '自定义竞赛'}}"
          class="form-input custom-contest-input"
          value="{{form.custom_contest_name}}"
          placeholder="请输入自定义竞赛名称"
          bindinput="onCustomContestInput"
        />
      </view>
      <view class="form-item">
        <view class="form-label">需求描述</view>
        <textarea class="form-textarea" data-field="description" value="{{form.description}}" placeholder="用简单话说明你要做什么、目前缺什么、希望队友投入多少时间" bindinput="onFormInput" maxlength="600" />
      </view>
      <view class="form-item">
        <view class="form-label">岗位与人数</view>
        <block wx:for="{{roleRows}}" wx:key="index" wx:for-index="roleIndex" wx:for-item="role">
          <view class="role-edit-card">
            <view class="role-edit-head">
              <view class="role-edit-title">岗位{{roleIndex + 1}}</view>
              <button wx:if="{{roleRows.length > 1}}" class="danger-btn tiny" size="mini" data-index="{{roleIndex}}" bindtap="removeRoleRow">删除</button>
            </view>
            <input
              class="form-input"
              data-index="{{roleIndex}}"
              data-field="name"
              value="{{role.name}}"
              placeholder="岗位名称，例如：算法、论文、PPT、后端"
              bindinput="onRoleInput"
            />
            <input
              class="form-input role-field-gap"
              type="number"
              data-index="{{roleIndex}}"
              data-field="needed"
              value="{{role.needed}}"
              placeholder="需要人数"
              bindinput="onRoleInput"
            />
            <textarea
              class="form-textarea mini"
              data-index="{{roleIndex}}"
              data-field="skills"
              value="{{role.skills}}"
              placeholder="需要能力，例如：Python、数据分析、论文写作"
              bindinput="onRoleInput"
              maxlength="160"
            />
          </view>
        </block>
        <button class="secondary-btn full" size="mini" bindtap="addRoleRow">添加岗位</button>
      </view>
      <view class="form-item">
        <view class="form-label">方向标签</view>
        <view class="tag-panel compact-tags">
          <block wx:for="{{recruitTagOptions}}" wx:key="label">
            <view class="interest-chip {{item.selected ? 'active' : ''}}" data-label="{{item.label}}" bindtap="toggleRecruitTag">
              {{item.label}}
            </view>
          </block>
        </view>
        <view class="custom-interest">
          <input placeholder="添加自定义方向" value="{{customRecruitTag}}" bindinput="onCustomRecruitTagInput" />
          <button size="mini" bindtap="addCustomRecruitTag">添加</button>
        </view>
      </view>

      <view class="gate-title">申请门槛（可选）</view>
      <view class="picker-row">
        <picker mode="selector" range="{{gateCampusOptions}}" value="{{gateCampusIndex}}" bindchange="onGateCampusChange">
          <view class="picker-box">{{gateCampusOptions[gateCampusIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{gateCollegeOptions}}" value="{{gateCollegeIndex}}" bindchange="onGateCollegeChange">
          <view class="picker-box">{{gateCollegeOptions[gateCollegeIndex]}}</view>
        </picker>
      </view>
      <view class="picker-row">
        <picker mode="selector" range="{{gateMajorOptions}}" value="{{gateMajorIndex}}" bindchange="onGateMajorChange">
          <view class="picker-box">{{gateMajorOptions[gateMajorIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{gateGradeOptions}}" value="{{gateGradeIndex}}" bindchange="onGateGradeChange">
          <view class="picker-box">{{gateGradeOptions[gateGradeIndex]}}</view>
        </picker>
      </view>

      <view class="switch-row">
        <view>
          <view class="switch-title">要求申请说明</view>
          <view class="switch-desc">开启后，申请者必须写一段优势说明。</view>
        </view>
        <switch checked="{{form.require_statement}}" bindchange="onRequireStatementChange" color="{{isDarkTheme ? '#7FB7C8' : '#67B3DB'}}" />
      </view>

      <view class="form-actions">
        <button class="secondary-btn" size="mini" bindtap="polishRecruitment">AI辅助整理</button>
        <button class="primary-btn" size="mini" loading="{{publishing}}" bindtap="publishRecruitment">发布招募</button>
      </view>
    </view>
  </block>

  <block wx:if="{{activeTab == 'applications'}}">
    <view class="section-title">我的申请与组队</view>
    <view wx:if="{{myRecruit.penalty}}" class="notice-card danger">
      <view class="notice-title">组队限制中</view>
      <view class="notice-text">原因：{{myRecruit.penalty.reason}}；限制至 {{myRecruit.penalty.until}}</view>
    </view>

    <view class="subsection-title">收到的申请</view>
    <view wx:if="{{myRecruit.received.length == 0}}" class="empty-card small">暂无收到的申请</view>
    <block wx:for="{{myRecruit.received}}" wx:key="id" wx:for-item="app">
      <view class="application-card">
        <view class="card-title">{{app.post_title}} / {{app.role_name}}</view>
        <view class="publisher-line">申请人：{{app.applicant_profile.name}} · {{app.applicant_profile.grade}} · {{app.applicant_profile.college}}</view>
        <view class="publisher-line">{{app.applicantContactText}}</view>
        <view class="application-statement">申请说明：{{app.statement || '未填写'}}</view>
        <view class="score-text">适配度 {{app.match_score}}：{{app.scoreDetailText}}</view>
        <view class="application-status">{{app.statusText}}</view>
        <view wx:if="{{app.status == 'pending'}}" class="btn-row">
          <button class="primary-btn" size="mini" data-id="{{app.id}}" data-decision="accept" bindtap="decideApplication">同意</button>
          <button class="danger-btn" size="mini" data-id="{{app.id}}" data-decision="reject" bindtap="decideApplication">拒绝</button>
        </view>
      </view>
    </block>

    <view class="subsection-title">我发出的申请</view>
    <view wx:if="{{myRecruit.sent.length == 0}}" class="empty-card small">暂无发出的申请</view>
    <block wx:for="{{myRecruit.sent}}" wx:key="id" wx:for-item="app">
      <view class="application-card">
        <view class="card-title">{{app.post_title}} / {{app.role_name}}</view>
        <view class="publisher-line">状态：{{app.statusText}} · 适配度 {{app.match_score}}</view>
        <view class="application-statement">申请说明：{{app.statement || '未填写'}}</view>
      </view>
    </block>

    <view class="subsection-title">已匹配队伍</view>
    <view wx:if="{{myRecruit.matched.length == 0}}" class="empty-card small">暂无已匹配队伍</view>
    <block wx:for="{{myRecruit.matched}}" wx:key="id" wx:for-item="post">
      <view class="post-card compact">
        <view class="card-title">{{post.title}}</view>
        <view class="publisher-line">发布者：{{post.publisher_profile.name}} / {{post.publisherContactText}}</view>
        <button wx:if="{{!post.is_publisher}}" class="danger-btn tiny" size="mini" data-postid="{{post.id}}" data-userid="{{post.publisher_id}}" bindtap="complainMember">投诉发布者</button>
        <block wx:for="{{post.roles}}" wx:key="id" wx:for-item="role">
          <view wx:if="{{role.confirmed_members.length > 0}}" class="matched-role">
            <view class="role-title">{{role.name}}</view>
            <block wx:for="{{role.confirmed_members}}" wx:key="user_id" wx:for-item="member">
              <view class="member-row">
                <view>{{member.profile.name}} · {{member.contactText}}</view>
                <view wx:if="{{!member.isMe}}" class="member-actions">
                  <button class="secondary-btn tiny" size="mini" data-postid="{{post.id}}" data-userid="{{member.user_id}}" bindtap="requestUnbind">申请解绑</button>
                  <button class="danger-btn tiny" size="mini" data-postid="{{post.id}}" data-userid="{{member.user_id}}" bindtap="complainMember">投诉</button>
                </view>
              </view>
            </block>
          </view>
        </block>
      </view>
    </block>
  </block>

  <block wx:if="{{activeTab == 'mentor'}}">
    <view class="section-head">
      <view>
        <view class="section-title">官方导师库</view>
        <view class="section-desc">{{mentorSourceText}} · {{mentorUpdatedAt}}</view>
      </view>
      <button class="mini-btn" size="mini" loading="{{refreshingMentors}}" bindtap="refreshMentors">刷新</button>
    </view>

    <view class="mentor-filter-box">
      <view class="search-row">
        <input
          class="search-input"
          value="{{mentorKeyword}}"
          placeholder="搜索导师姓名、学院、研究方向"
          bindinput="onMentorKeywordInput"
          bindconfirm="searchMentors"
        />
        <button class="search-btn" size="mini" bindtap="searchMentors">搜索</button>
      </view>
      <view class="picker-row">
        <picker mode="selector" range="{{mentorCampusOptions}}" value="{{selectedCampusIndex}}" bindchange="onMentorCampusChange">
          <view class="picker-box">{{mentorCampusOptions[selectedCampusIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{mentorCollegeOptions}}" value="{{selectedCollegeIndex}}" bindchange="onMentorCollegeChange">
          <view class="picker-box">{{mentorCollegeOptions[selectedCollegeIndex]}}</view>
        </picker>
      </view>
      <view class="mentor-page-meta">共 {{mentorTotal}} 条 · 第 {{mentorPage}} / {{mentorTotalPages}} 页 · 本页 {{mentorList.length}} 条</view>
    </view>

    <view wx:if="{{mentorList.length == 0 && !mentorLoading}}" class="empty-card">暂未抓取到导师信息，可点击刷新。</view>
    <view wx:if="{{mentorLoading}}" class="empty-card">导师库加载中...</view>
    <block wx:for="{{mentorList}}" wx:key="id" wx:for-item="mentor">
      <view class="mentor-card">
        <view class="card-top">
          <view>
            <view class="card-title">{{mentor.name}} · {{mentor.title}}</view>
            <view class="card-subtitle">{{mentor.campus}} / {{mentor.college}} {{mentor.department}}</view>
          </view>
        </view>
        <view class="post-desc">研究方向：{{mentor.research || '官方页暂未提取到研究方向'}}</view>
        <view class="publisher-line">联系方式：{{mentor.contactText}}</view>
        <view class="tag-line">{{mentor.tagText}}</view>
        <button class="secondary-btn full" size="mini" data-url="{{mentor.homepage}}" bindtap="openOfficialPage">查看官方主页</button>
      </view>
    </block>
    <view class="mentor-page-actions">
      <button class="secondary-btn" size="mini" bindtap="prevMentorPage" disabled="{{mentorPage <= 1}}">上一页</button>
      <button class="secondary-btn" size="mini" bindtap="nextMentorPage" disabled="{{mentorPage >= mentorTotalPages}}">下一页</button>
    </view>
  </block>

  <view wx:if="{{contestSelectorVisible}}" class="contest-selector-mask" catchtap="closeContestSelector">
    <view class="contest-selector-panel" catchtap="stopTap">
      <view class="contest-selector-head">
        <view class="selector-cancel" bindtap="closeContestSelector">取消</view>
        <view class="selector-title">选择目标竞赛</view>
        <view class="selector-done" bindtap="closeContestSelector">确定</view>
      </view>
      <view class="contest-search-box">
        <input
          class="contest-search-input"
          value="{{contestSearchKeyword}}"
          placeholder="输入竞赛名称、方向或关键词"
          placeholder-style="color:{{isDarkTheme ? '#9BA8AB' : 'rgba(17, 17, 17, 0.62)'}}"
          confirm-type="search"
          bindinput="onContestSearchInput"
        />
        <button wx:if="{{contestSearchKeyword}}" class="contest-search-clear" size="mini" bindtap="clearContestSearch">清除</button>
      </view>
      <scroll-view class="contest-option-list" scroll-y>
        <view class="contest-option-item {{contestIndex == 0 ? 'active' : ''}}" data-type="placeholder" bindtap="selectContestOption">
          <view class="contest-option-name">请选择目标竞赛</view>
          <view class="contest-option-desc">清空当前选择</view>
        </view>
        <block wx:for="{{contestSearchResults}}" wx:key="key">
          <view class="contest-option-item {{item.index == contestIndex ? 'active' : ''}}" data-type="{{item.type}}" data-index="{{item.index}}" data-name="{{item.name}}" bindtap="selectContestOption">
            <view class="contest-option-name">{{item.name}}</view>
            <view class="contest-option-desc">{{item.desc}}</view>
          </view>
        </block>
        <view wx:if="{{contestSearchResults.length == 0}}" class="contest-option-empty">
          没有找到匹配竞赛，可以使用自定义竞赛名称。
        </view>
        <view class="contest-option-item custom" data-type="custom" bindtap="selectContestOption">
          <view class="contest-option-name">自定义竞赛</view>
          <view class="contest-option-desc">{{contestSearchKeyword ? '使用“' + contestSearchKeyword + '”作为竞赛名称' : '列表里没有时可手动填写'}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>


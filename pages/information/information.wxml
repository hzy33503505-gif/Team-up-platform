<view class="container {{themeClass}}">
  <form bindsubmit="onSubmit">
    <view class="quick-card">
      <view class="form-item">
        <text class="label">头像</text>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        </button>
      </view>

      <view class="form-item">
        <text class="label required">姓名</text>
        <input name="name" type="text" placeholder="请输入姓名" value="{{userInfo.name}}" />
      </view>

      <view class="form-item">
        <text class="label required">学号</text>
        <input name="studentId" type="number" placeholder="用于校内联系与匹配识别" value="{{userInfo.studentId}}" />
      </view>
    </view>

    <view class="section-title">联系方式</view>
    <view class="quick-card">
      <view class="form-item">
        <text class="label">手机号</text>
        <input name="phone" type="number" placeholder="选填" value="{{userInfo.phone}}" />
        <view class="public-switch">
          <text>公开</text>
          <switch checked="{{userInfo.phonePublic}}" bindchange="onPhonePublicChange" color="{{isDarkTheme ? '#7FB7C8' : '#67B3DB'}}" />
        </view>
      </view>

      <view class="form-item">
        <text class="label">QQ号</text>
        <input name="qq" type="number" placeholder="选填" value="{{userInfo.qq}}" />
        <view class="public-switch">
          <text>公开</text>
          <switch checked="{{userInfo.qqPublic}}" bindchange="onQqPublicChange" color="{{isDarkTheme ? '#7FB7C8' : '#67B3DB'}}" />
        </view>
      </view>
      <view class="source-tip">学号默认对招募和申请双方可见；手机号、QQ 只有开启公开后才展示。</view>
    </view>

    <view class="section-title">校区与专业</view>
    <view class="source-tip">已补充威海校区紫丁香书院；所有层级保留“其他/自定义”。</view>
    <view class="quick-card">
      <view class="form-item">
        <text class="label required">校区</text>
        <picker mode="selector" range="{{campusOptions}}" value="{{campusIndex}}" bindchange="onCampusChange">
          <view class="picker-value">{{campusOptions[campusIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{isCustomCampus}}" class="custom-input">
        <input placeholder="请输入校区/培养地点" value="{{customCampus}}" data-field="customCampus" bindinput="onTextInput" />
      </view>

      <view class="form-item">
        <text class="label required">学院</text>
        <picker mode="selector" range="{{collegeOptions}}" value="{{collegeIndex}}" bindchange="onCollegeChange">
          <view class="picker-value">{{collegeOptions[collegeIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{isCustomCollege}}" class="custom-input">
        <input placeholder="请输入学院/书院" value="{{customCollege}}" data-field="customCollege" bindinput="onTextInput" />
      </view>

      <view class="form-item">
        <text class="label required">专业</text>
        <picker mode="selector" range="{{majorOptions}}" value="{{majorIndex}}" bindchange="onMajorChange">
          <view class="picker-value">{{majorOptions[majorIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{isCustomMajor}}" class="custom-input">
        <input placeholder="请输入专业或未分流大类" value="{{customMajor}}" data-field="customMajor" bindinput="onTextInput" />
      </view>

      <view class="form-item">
        <text class="label required">年级</text>
        <picker name="grade" mode="selector" range="{{gradeOptions}}" value="{{gradeIndex}}" bindchange="onGradeChange">
          <view class="picker-value">{{gradeOptions[gradeIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="section-title">意向方向</view>
    <view class="tag-panel">
      <block wx:for="{{interestOptions}}" wx:key="label">
        <view class="interest-chip {{item.selected ? 'active' : ''}}" data-label="{{item.label}}" bindtap="toggleInterest">
          {{item.label}}
        </view>
      </block>
    </view>
    <view class="custom-interest">
      <input placeholder="添加自定义意向" value="{{customInterest}}" data-field="customInterest" bindinput="onTextInput" />
      <button size="mini" bindtap="addCustomInterest">添加</button>
    </view>

    <view class="section-title">学分绩</view>
    <view class="quick-card">
      <view class="form-item">
        <text class="label">学分绩</text>
        <input name="gpa" type="digit" placeholder="选填，例如 88.5 或 3.7" value="{{userInfo.gpa}}" />
      </view>
    </view>

    <view class="section-title">竞赛经历</view>
    <view class="text-area-container">
      <textarea name="competition" placeholder="例如：2025 全国大学生数学建模竞赛 省级一等奖；负责建模和论文" value="{{userInfo.competition}}" maxlength="500" auto-height />
    </view>

    <view class="section-title">项目经验</view>
    <view class="text-area-container">
      <textarea name="project" placeholder="例如：智能小车控制系统，负责视觉识别与硬件调试" value="{{userInfo.project}}" maxlength="500" auto-height />
    </view>

    <button class="submit-btn" form-type="submit">保存信息</button>
  </form>
</view>


/* pages/information/information.wxss */

.container {
  padding: 30rpx;
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  min-height: 100vh;
}

.quick-card {
  background: var(--color-surface);
  border-radius: 16rpx;
  padding: 0 22rpx;
  margin-bottom: 12rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 146rpx;
  font-size: 30rpx;
  color: var(--color-text);
}

.required::after {
  content: "*";
  color: var(--color-text);
  margin-left: 4rpx;
}

.form-item input {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
  padding: 10rpx 0;
  min-width: 0;
}

.picker-value {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
  min-height: 44rpx;
  line-height: 44rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--color-surface);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text);
  margin: 40rpx 0 20rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid var(--color-primary-soft);
}

.source-tip {
  font-size: 23rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
  margin: -8rpx 0 12rpx 18rpx;
}

.quick-card .source-tip {
  margin: 0;
  padding: 0 0 22rpx;
}

.public-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  margin-left: 12rpx;
}

.custom-input {
  padding: 0 0 22rpx 146rpx;
}

.custom-input input,
.custom-interest input {
  background: var(--color-surface-soft);
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.tag-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.interest-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 24rpx;
  border: 1rpx solid var(--color-border);
}

.interest-chip.active {
  background: var(--color-primary-soft);
  color: var(--color-text);
  border-color: var(--color-text);
  font-weight: 700;
}

.custom-interest {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 12rpx;
}

.custom-interest input {
  flex: 1;
}

.custom-interest button {
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 10rpx;
}

.text-area-container {
  background-color: var(--color-surface);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 10rpx;
}

.text-area-container textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  background-color: var(--color-surface);
  border-radius: 12rpx;
  padding: 20rpx;
}

.submit-btn {
  margin: 60rpx 0 40rpx;
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 48rpx;
  font-size: 30rpx;
  border: none;
}
.submit-btn:active { background: var(--color-primary); }

/* sticky-rice ice-cream premium UI */
.container {
  background:
    radial-gradient(circle at 50% 12%, var(--color-surface-glow), transparent 36%),
    linear-gradient(
      180deg,
      var(--color-bg-soft) 0%,
      var(--color-bg) 42%,
      var(--color-accent-warm) 100%
    );
  color: var(--color-text);
}

.quick-card,
.text-area-container {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 44rpx var(--color-shadow);
}

.form-item {
  border-bottom-color: var(--color-border);
}

.label,
.section-title,
.picker-value,
.form-item input {
  color: var(--color-text);
}

.source-tip,
.public-switch {
  color: var(--color-text-muted);
}

.custom-input input,
.custom-interest input,
.text-area-container textarea {
  background: var(--color-surface-soft);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.interest-chip {
  background: var(--color-surface-soft);
  color: var(--color-text);
  border-color: var(--color-border);
}

.interest-chip.active {
  background: var(--color-primary-soft);
  color: var(--color-text);
  border-color: var(--color-text);
}

.custom-interest button,
.submit-btn {
  background: var(--color-primary);
  color: var(--color-primary-text);
  border-radius: 999rpx;
  font-weight: 800;
}

.section-title {
  border-left-color: var(--color-primary);
}

